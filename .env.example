# Food Analysis Mode: 'cv' for Python MobileNetV2, 'gemini' for Google Gemini
# Default is 'cv' (Python CV server)
VITE_ANALYSIS_MODE=cv

# Python CV Server URL (default: http://localhost:5001)
VITE_CV_SERVER_URL=https://fitnessapp-cugp.onrender.com/

# Google Gemini API Key (optional - only needed if using 'gemini' mode)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GOOGLE_API_KEY=your_gemini_api_key_here
